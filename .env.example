# API Cinéma — https://api-cinema.com (server-side only, never expose to the client)
API_CINEMA_KEY=ac_live_xxxxxxxx

# Optional — free TMDB key (v3 key or v4 read token) used to find posters the cinemas don't provide
TMDB_API_KEY=

# Shared secret for /api/revalidate (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-to-a-long-random-string
